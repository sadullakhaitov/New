# @BotFather bergan token (hech kimga ko'rsatmang, GitHub'ga yuklamang)
BOT_TOKEN=

# Mini App ochiladigan ommaviy HTTPS manzil (masalan https://emirfood.onrender.com).
# Render'da yozish shart emas — avtomatik olinadi.
BASE_URL=

# polling — kompyuterda yoki doimiy serverda; webhook — Render kabi "uxlaydigan" hostingda
MODE=polling

# Veb-server porti (ko'p hostinglar PORT ni o'zi beradi)
PORT=8080

# Botning bosh adminlari Telegram ID raqamlari, vergul bilan (ixtiyoriy).
# Ular har doim admin panelga kira oladi va /setgroup qila oladi.
SUPERADMIN_IDS=

# PostgreSQL manzili (masalan Neon). Bo'sh bo'lsa — data/ papkasidagi SQLite fayl ishlatiladi.
DATABASE_URL=

# SQLite fayli turadigan papka
DATA_DIR=data

# Render'da serverni uxlatmaslik (har 10 daqiqada o'ziga so'rov). Render'da o'zi yoqiladi;
# o'chirish uchun 0, boshqa "uxlaydigan" hostingda yoqish uchun 1.
KEEPALIVE=
